# ============================================================
# NineOS Backend — Environment Variables
# Salin file ini ke .env lalu isi nilainya
# JANGAN commit .env ke git
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://nineos:nineos_pass@localhost:5432/nineos_db?schema=public"

# API Gateway auth token — generate dengan: openssl rand -hex 32
GATEWAY_TOKEN="ganti_dengan_token_random_minimal_32_karakter"

# Enkripsi kredensial AES-256-GCM — generate dengan: openssl rand -hex 32
ENCRYPTION_KEY="ganti_dengan_hex_string_64_karakter"

# Port aplikasi
PORT=3000

# Environment
NODE_ENV=development

# ── Agentic AI Layer (Wave 6) ──────────────────────────────────
# AGENT_AUTONOMY: 'guarded' (default) = tool sensitif wajib approval kapten
#                 'full'              = tool sensitif jalan otomatis (hati-hati)
# AGENT_WATCHER:  'off' untuk mematikan cron snapshot + briefing pagi
AGENT_AUTONOMY=guarded
AGENT_WATCHER=on

# KPI platform — konvensi: {SLUG}_API_URL + {SLUG}_NINEOS_KEY
NOTABE_API_URL=https://<project>.supabase.co/functions/v1
NOTABE_NINEOS_KEY=
