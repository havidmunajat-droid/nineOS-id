# Paksa devDependencies ikut terpasang, apa pun isi NODE_ENV.
#
# Kenapa perlu: build Next.js ini BUTUH beberapa paket yang tinggal di
# devDependencies, karena memang dipakai saat kompilasi, bukan saat runtime:
#   - @tailwindcss/postcss  → dirujuk postcss.config.mjs untuk memproses
#                             app/globals.css
#   - tailwindcss           → mesin CSS-nya
#   - typescript, @types/*  → dipakai next build untuk mengecek tipe
#
# Kalau NODE_ENV=production menyala saat install, npm menyetel omit=dev
# secara diam-diam dan semua paket di atas dilewati. Build lalu mati dengan:
#   Error: Turbopack build failed with 1 errors:
#   ./app/globals.css
#   Error: Cannot find module '@tailwindcss/postcss'
#
# Kembar dengan nineos-backend/.npmrc yang menyelesaikan masalah identik di
# Railway (di sana yang hilang binary `nest`). Diletakkan di repo, bukan
# sebagai variable platform, supaya perilakunya sama di Vercel maupun lokal
# dan tidak bisa hilang gara-gara setelan dashboard berubah.
include=dev
