# Var SERVER-SIDE (tanpa NEXT_PUBLIC_) — dipakai proxy BFF di
# app/api/[...path]/route.ts. Token TIDAK boleh berawalan NEXT_PUBLIC_,
# karena var berawalan itu ter-bundle ke browser dan bisa dibaca siapa pun.
NINEOS_API_URL=https://<backend-railway>/api/v1
NINEOS_GATEWAY_TOKEN=<gateway token yang sama dengan backend>
